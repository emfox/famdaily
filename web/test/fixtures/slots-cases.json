    {
      "name": "跟随早饭，饭前 60 分钟 → 落到前一天",
      "备注": "07:30 - 60 = 390，嗯，07:30 是 450，450-60=390=06:30 同天。改用 00:10 早饭才能跨天，但早饭时刻是用户可改的，所以用 overrides 造一个 00:10 的早饭。00:10=10，10-60=-50，floor(-50/1440)=-1 → 前一天 23:10。⚠️ 用 Math.trunc 会得到 -0 → 当天 23:10，差一天",
      "date": "2026-10-24",
      "tasks": [
        {
          "id": "a1",
          "repeat": {},
          "time": {
            "type": "meal",
            "anchors": [
              "breakfast"
            ],
            "offset": -60,
            "overrides": {
              "breakfast": "00:10"
            }
          },
          "courseStart": null,
          "courseEnd": null,
          "courseTotalDays": null
        }
      ],
      "expected": [
        [
          "a1",
          0,
          "2026-10-23",
          "23:10"
        ]
      ],
      "spanDays": 1
    },
